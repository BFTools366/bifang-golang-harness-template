{
  "schema_version": 1,
  "default_mode": "protected",
  "rules": [
    {
      "pattern": "Version.md",
      "mode": "tombstone"
    },
    {
      "pattern": ".agents/skills/go-instantiate-project/**",
      "mode": "tombstone"
    },
    {
      "pattern": ".agents/skills/go-initialize-go-project/**",
      "mode": "tombstone"
    },
    {
      "pattern": ".agents/skills/go-test-initialization-e2e/**",
      "mode": "tombstone"
    },
    {
      "pattern": "scripts/validate_harness.py",
      "mode": "tombstone"
    },
    {
      "pattern": "scripts/run_tests.py",
      "mode": "tombstone"
    },
    {
      "pattern": "scripts/test_run_tests.py",
      "mode": "tombstone"
    },
    {
      "pattern": "scripts/test_agile_workflow.py",
      "mode": "tombstone"
    },
    {
      "pattern": "scripts/test_harness_scope_and_initialization_boundaries.py",
      "mode": "tombstone"
    },
    {
      "pattern": "scripts/test_validate_harness.py",
      "mode": "tombstone"
    },
    {
      "pattern": "scripts/harness_validation/**",
      "mode": "tombstone"
    },
    {
      "pattern": "docs/HARNESS_ENGINEERING.md",
      "mode": "tombstone"
    },
    {
      "pattern": "docs/harness_engineering/**",
      "mode": "tombstone"
    },
    {
      "pattern": "docs/AGENT_POLICY.md",
      "mode": "protected"
    },
    {
      "pattern": "docs/GUI_SUPPORT_SURFACES.md",
      "mode": "protected"
    },
    {
      "pattern": "docs/product_spec/**",
      "mode": "protected"
    },
    {
      "pattern": "docs/project_status/**",
      "mode": "protected"
    },
    {
      "pattern": "docs/work_plan/**",
      "mode": "protected"
    },
    {
      "pattern": "docs/adr/**",
      "mode": "protected"
    },
    {
      "pattern": "docs/changelog/**",
      "mode": "protected"
    },
    {
      "pattern": "docs/VERIFICATION.md",
      "mode": "protected"
    },
    {
      "pattern": "docs/verification/**",
      "mode": "protected"
    },
    {
      "pattern": "docs/TECH_DEBT.md",
      "mode": "protected"
    },
    {
      "pattern": ".harness/version-state.json",
      "mode": "protected"
    },
    {
      "pattern": ".harness/release-context.json",
      "mode": "protected"
    },
    {
      "pattern": "release-notes.json",
      "mode": "protected"
    },
    {
      "pattern": "LICENSE.zh-CN.md",
      "mode": "protected"
    },
    {
      "pattern": "LICENSE.en.md",
      "mode": "protected"
    },
    {
      "pattern": "go.mod",
      "mode": "protected"
    },
    {
      "pattern": "go.sum",
      "mode": "protected"
    },
    {
      "pattern": ".gitignore",
      "mode": "protected"
    },
    {
      "pattern": "AGENTS.md",
      "mode": "merge-sections"
    },
    {
      "pattern": "README.md",
      "mode": "merge-sections"
    },
    {
      "pattern": "docs/ENGINEERING_RULES.md",
      "mode": "merge-sections"
    },
    {
      "pattern": "docs/GO_WEB_TEMPLATE.md",
      "mode": "merge-sections"
    },
    {
      "pattern": "docs/RELEASE.md",
      "mode": "merge-sections"
    },
    {
      "pattern": "docs/design_standards/**",
      "mode": "managed"
    },
    {
      "pattern": ".agents/skills/go-implement-change/scripts/check_file_line_limits.py",
      "mode": "managed"
    },
    {
      "pattern": ".agents/skills/go-implement-change/scripts/test_check_file_line_limits.py",
      "mode": "managed"
    },
    {
      "pattern": ".agents/skills/go-implement-change/scripts/check_core_first.py",
      "mode": "managed"
    },
    {
      "pattern": ".agents/skills/go-implement-change/scripts/test_check_core_first.py",
      "mode": "managed"
    },
    {
      "pattern": ".agents/skills/go-manage-git-lifecycle/**",
      "mode": "managed"
    },
    {
      "pattern": ".agents/skills/go-upgrade-harness/**",
      "mode": "managed-self"
    },
    {
      "pattern": ".agents/skills/go-add-tui-adapter/**",
      "mode": "conditional"
    },
    {
      "pattern": ".agents/skills/go-add-http-adapter/**",
      "mode": "conditional"
    },
    {
      "pattern": ".agents/skills/go-prepare-release/**",
      "mode": "conditional"
    },
    {
      "pattern": ".agents/skills/go-build-local/**",
      "mode": "conditional"
    },
    {
      "pattern": ".agents/skills/go-build-release/**",
      "mode": "conditional"
    },
    {
      "pattern": ".agents/skills/**",
      "mode": "managed"
    }
  ]
}
